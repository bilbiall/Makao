APP_NAME=Renty
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL - shared/cPanel hosting typically provisions this for you
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# SMS notifications (TextSMS gateway) - uncomment and fill in to enable SMS.
# Without these, SmsHelper::sendSms() throws internally; every call site catches
# this, so the app degrades gracefully (no SMS sent) rather than breaking.
# TEXTSMS_API_KEY=
# TEXTSMS_PARTNER_ID=
# TEXTSMS_SENDER_ID=
# TEXTSMS_URL=

# Session/queue: "database" is deliberate - no Redis/Supervisor dependency, so this
# runs on plain shared/cPanel hosting. Requires the sessions/jobs tables (already
# migrated) and a cron entry running `schedule:run` (see docs/DEPLOYMENT.md) so
# queued jobs and scheduled commands (auto-invoicing, trial expiry) actually execute.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing email (password resets, welcome emails, notifications). Most cPanel hosts
# provide an SMTP relay for your domain - use that here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# M-Pesa and Pesapal credentials are NOT read from this file - they're configured
# per-deployment via the admin panel (Filament Settings page), stored in the
# `app_settings` table. Log in as an admin/landlord after deploying and fill them
# in under Settings > Payments.
